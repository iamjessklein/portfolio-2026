{%- if bodyClass == "garden-home" %}
<script>
(function(){
  var c=document.getElementById('motes'); if(!c) return;
  var x=c.getContext('2d'), still=matchMedia('(prefers-reduced-motion: reduce)').matches, W=0,H=0,dpr=1,P=[];
  function size(){dpr=Math.min(devicePixelRatio||1,2);W=c.clientWidth;H=c.clientHeight;c.width=W*dpr;c.height=H*dpr;x.setTransform(dpr,0,0,dpr,0,0);}
  function make(){P=[];var n=Math.round(Math.min(90,Math.max(36,W/16)));
    for(var i=0;i<n;i++)P.push({x:Math.random()*W,y:Math.random()*H,r:.8+Math.random()*2.4,vx:(Math.random()-.5)*.12,vy:-.04-Math.random()*.14,ph:Math.random()*6.28,a:.25+Math.random()*.45});}
  function draw(t){
    x.clearRect(0,0,W,H);
    for(var i=0;i<P.length;i++){var p=P[i];
      if(!still){p.x+=p.vx+Math.sin(t/4000+p.ph)*.05;p.y+=p.vy;
        if(p.y<-6){p.y=H+6;p.x=Math.random()*W} if(p.x<-6)p.x=W+6; if(p.x>W+6)p.x=-6;}
      var tw=still?1:.75+.25*Math.sin(t/1800+p.ph);
      x.beginPath();x.arc(p.x,p.y,p.r,0,6.283);x.fillStyle='rgba(255,255,255,'+(p.a*tw).toFixed(3)+')';x.fill();}
    if(!still) requestAnimationFrame(draw);
  }
  size();make();requestAnimationFrame(draw);
  addEventListener('resize',function(){size();make();if(still)draw(0);});
})();
</script>
{%- endif %}
</body>
</html>
