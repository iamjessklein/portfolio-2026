{% macro stageGlyph(name, size=28) %}
{%- if name == "seedling" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#1F3D2E" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21v-9"/><path d="M12 13c-3.5 0-5.5-2-5.5-5 3.5 0 5.5 2 5.5 5z"/></svg>
{%- elif name == "budding" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#1F3D2E" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21V10"/><path d="M12 17c-3 0-5-1.5-5-4 3 0 5 1.5 5 4z"/><circle cx="12" cy="6.5" r="3"/></svg>
{%- else -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#1F3D2E" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l5.5 7h-11z"/><path d="M12 9l7 8H5z"/><path d="M12 17v4"/></svg>
{%- endif -%}
{% endmacro %}

{% macro gardenGlyph(name, size=18) %}
{%- if name == "community" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#1F3D2E" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="13" r="2.4"/><circle cx="12" cy="7" r="2.4"/><circle cx="18" cy="13" r="2.4"/><path d="M4 20h16"/></svg>
{%- else -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#1F3D2E" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M7 14h10l-1.5 7h-7z"/><path d="M12 14V9"/><path d="M12 10.5c-3 0-4.5-2-4.5-4.5 3 0 4.5 2 4.5 4.5z"/></svg>
{%- endif -%}
{% endmacro %}

{% macro tendGlyph(size=16) %}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#2F5266" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 10h10v9a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z"/><path d="M15 13l6-5"/><path d="M5 12.5c-3.5 0-3.5 5 0 5"/><path d="M8 6.5c1-2 5-2 6 0"/></svg>
{% endmacro %}

{# Simple one-colour line icons for the filter chips; they take the chip's text colour. #}
{% macro chipIcon(name, size=18) %}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
{%- if name == "seedling" -%}
<path d="M12 21v-9"/><path d="M12 13c-3.5 0-5.5-2-5.5-5 3.5 0 5.5 2 5.5 5z"/>
{%- elif name == "budding" -%}
<path d="M12 21V10"/><path d="M12 17c-3 0-5-1.5-5-4 3 0 5 1.5 5 4z"/><circle cx="12" cy="6.5" r="3"/>
{%- elif name == "evergreen" -%}
<path d="M12 3l5.5 7h-11z"/><path d="M12 9l7 8H5z"/><path d="M12 17v4"/>
{%- elif name == "community" -%}
<circle cx="6" cy="13" r="2.4"/><circle cx="12" cy="7" r="2.4"/><circle cx="18" cy="13" r="2.4"/><path d="M4 20h16"/>
{%- else -%}
<path d="M7 14h10l-1.5 7h-7z"/><path d="M12 14V9"/><path d="M12 10.5c-3 0-4.5-2-4.5-4.5 3 0 4.5 2 4.5 4.5z"/>
{%- endif -%}
</svg>
{% endmacro %}
