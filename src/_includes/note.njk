---
layout: base.njk
---
{% from "glyphs.njk" import stageGlyph, gardenGlyph %}
<article class="note">
  <h1>{{ title }}</h1>
  <p class="status">
    <span class="stagechip" tabindex="0" data-tip="{{ tips[stage] }}">{{ stageGlyph(stage, 28) }}<b>{{ stage | capitalize }}</b></span>
    <span class="gardenchip" tabindex="0" data-tip="{{ tips[garden] }}">{{ gardenGlyph(garden, 18) }}{{ garden | capitalize }} garden</span>
    {% for t in topics %}<span class="topic">#{{ t }}</span>{% endfor %}
  </p>
  {% if summary %}<p class="summary">{{ summary }}</p>{% endif %}
  <div class="body">{{ content | safe }}</div>
  {%- for g in writing.groups %}{% if g.slug == page.fileSlug and g.posts.length %}
  <section class="aboutwriting">
    <h2>Writing about this</h2>
    {%- for p in g.posts %}
    <div class="post"><span class="pdate">{{ p.date }}</span><span><a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.title }}</a><span class="psrc">{{ p.src }}</span></span></div>
    {%- endfor %}
    <p class="gsoft"><a href="/writing/#{{ g.slug }}">See everything on the Writing page →</a></p>
  </section>
  {% endif %}{% endfor -%}
</article>
