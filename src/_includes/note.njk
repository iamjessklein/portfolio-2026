---
layout: base.njk
---
{% from "glyphs.njk" import stageGlyph, gardenGlyph %}
<article class="note">
  <h1>{{ title }}</h1>
  <p class="status">
    <span class="stagechip">{{ stageGlyph(stage, 28) }}<b>{{ stage | capitalize }}</b></span>
    <span class="gardenchip">{{ gardenGlyph(garden, 18) }}{{ garden | capitalize }} garden</span>
    {% for t in topics %}<span class="topic">#{{ t }}</span>{% endfor %}
  </p>
  {% if summary %}<p class="summary">{{ summary }}</p>{% endif %}
  <div class="body">{{ content | safe }}</div>
</article>
