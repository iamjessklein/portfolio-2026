---
layout: base.njk
title: Bookshelf
---
<section class="pagehead">
  <h1>Bookshelf</h1>
  <p class="lede">Everything I’ve been reading, tracked for years on <a href="{{ books.profile }}" target="_blank" rel="noopener">Goodreads</a>. The books I’ve written about grow into notes in the garden. The rest sit on the shelf.</p>
</section>

<div class="stats">
  {%- for s in books.stats %}
  <div class="stat"><div class="sn">{{ s.n }}</div><div class="sl">{{ s.label }}</div></div>
  {%- endfor %}
</div>

<section class="block">
  <h2>Favorites</h2>
  <p class="sub">The books I’d hand to a stranger.</p>
  <div class="shelf" role="list" tabindex="0" aria-label="Books, scrolls sideways">
    <div class="spines">
      {%- set colors = ["#FFF1A8", "#DCE8C4", "#F6D9C0", "#D3E6E3", "#E6DDF0", "#F4EDDC"] %}
      {%- set rots = [-1.2, 0.8, -0.5, 1.4, -0.9, 0.4] %}
      {%- for t in books.favorites %}
      <div class="spine" role="listitem" style="height:{{ t | spineHeight(loop.index0) }}px;width:{{ 44 + (loop.index0 % 4) * 6 }}px;background:{{ colors[loop.index0 % 6] }};transform:rotate({{ rots[loop.index0 % 6] }}deg)"><span>{{ t }}</span></div>
      {%- endfor %}
    </div>
  </div>
</section>

<div class="twocol">
  <section class="block">
    <h2>On the desk now</h2>
    <div class="desk">
      {%- for r in books.reading %}
      <div class="dbook">
        <div class="dt">{{ r.title }}</div>
        {% if r.author %}<div class="da">{{ r.author }}</div>{% endif %}
        {% if r.page %}<div class="prog"><div class="bar"><div style="width:{{ r.pct }}%"></div></div><span>p. {{ r.page }} of {{ r.total }}</span></div>{% endif %}
      </div>
      {%- endfor %}
    </div>
  </section>
  <section class="block">
    <h2>Shelves</h2>
    <div class="shelves">
      {%- for s in books.shelves %}
      <div><div class="shn">{{ s.name }} <span>· {{ s.count }}</span></div>{% if s.blurb %}<p>{{ s.blurb }}</p>{% endif %}</div>
      {%- endfor %}
      <div class="chips">
        {%- for t in books.tags %}<a class="chip" href="{{ books.profile }}" target="_blank" rel="noopener">#{{ t.name }} · {{ t.count }}</a>{%- endfor %}
      </div>
    </div>
  </section>
</div>

{% if books.reviewed.length %}
<section class="block">
  <h2>Books I’ve written about</h2>
  <div class="stickies">
  {%- for b in books.reviewed %}
  {%- set parts = b.author.split(' ') %}
  <article class="sticky s{{ loop.index0 % 5 }}">
    <p class="call" aria-hidden="true">{{ b.rating }}<br>{{ parts | last | first }}</p>
    <p class="au">{{ parts | last }}, {{ parts.slice(0, -1).join(' ') }}<span aria-label="{{ b.rating }} out of 5"> · {{ "★★★★★".slice(0, b.rating) }}</span></p>
    <h3><a href="{{ b.url }}" target="_blank" rel="noopener">{{ b.title | truncate(70) }}<span class="vh"> (opens on Goodreads, new tab)</span></a></h3>
    <p class="say">{{ b.summary }}</p>
    <p class="cat" aria-hidden="true">{{ b.url.split('/') | last }}</p>
    <svg class="ext" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg>
  </article>
  {%- endfor %}
  </div>
</section>
{% endif %}
