---
layout: base.njk
title: Jess Klein
bodyClass: garden-home
---
{% from "glyphs.njk" import stageGlyph, gardenGlyph %}
<section class="hero">
  <h1>Hi, I'm Jess. I design tools to foster learning, community, and experimentation.</h1>
  <p class="lede">Welcome to the garden. Some things here are finished. Others are still growing.</p>
</section>

<section class="filters" aria-label="Filter the garden">
  <div class="frow"><span class="flabel">Stage</span>
    <button class="pill" data-filter="stage" data-value="all" aria-pressed="true">All</button>
    <button class="pill" data-filter="stage" data-value="seedling" aria-pressed="false">{{ stageGlyph("seedling", 20) }}Seedling</button>
    <button class="pill" data-filter="stage" data-value="budding" aria-pressed="false">{{ stageGlyph("budding", 20) }}Budding</button>
    <button class="pill" data-filter="stage" data-value="evergreen" aria-pressed="false">{{ stageGlyph("evergreen", 20) }}Evergreen</button>
  </div>
  <div class="frow"><span class="flabel">Garden</span>
    <button class="pill" data-filter="garden" data-value="all" aria-pressed="true">All</button>
    <button class="pill" data-filter="garden" data-value="community" aria-pressed="false">{{ gardenGlyph("community", 20) }}Community</button>
    <button class="pill" data-filter="garden" data-value="balcony" aria-pressed="false">{{ gardenGlyph("balcony", 20) }}Balcony</button>
  </div>
  <p class="fnote">A community garden is something I made with a team. A balcony garden is something I made on my own.</p>
</section>

<ul class="rows">
{%- for note in collections.garden %}
  <li class="row" data-stage="{{ note.data.stage }}" data-garden="{{ note.data.garden }}">
    <div class="glyph">{{ stageGlyph(note.data.stage, 28) }}</div>
    <div class="rbody">
      <a class="rtitle" href="{{ note.url }}">{{ note.data.title }}</a>
      {% if note.data.summary %}<p class="rsum">{{ note.data.summary }}</p>{% endif %}
      <div class="rmeta">
        <b>{{ note.data.stage | capitalize }}</b>
        <span class="g">{{ gardenGlyph(note.data.garden, 16) }}{{ note.data.garden | capitalize }} garden</span>
      </div>
    </div>
  </li>
{%- endfor %}
</ul>
<p class="empty" hidden>Nothing planted here yet.</p>

<script>
(() => {
  const state = { stage: 'all', garden: 'all' };
  const rows = [...document.querySelectorAll('.row')];
  const pills = [...document.querySelectorAll('.pill')];
  const empty = document.querySelector('.empty');
  const apply = () => {
    let shown = 0;
    rows.forEach((r) => {
      const ok = (state.stage === 'all' || r.dataset.stage === state.stage) &&
                 (state.garden === 'all' || r.dataset.garden === state.garden);
      r.hidden = !ok;
      if (ok) shown++;
    });
    empty.hidden = shown !== 0;
    pills.forEach((p) => p.setAttribute('aria-pressed', String(state[p.dataset.filter] === p.dataset.value)));
  };
  pills.forEach((p) => p.addEventListener('click', () => { state[p.dataset.filter] = p.dataset.value; apply(); }));
})();
</script>
