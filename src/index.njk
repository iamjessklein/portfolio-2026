---
layout: base.njk
title: Jess Klein
bodyClass: garden-home
---
{% from "glyphs.njk" import chipIcon, stageGlyph, gardenGlyph, tendGlyph %}
<section class="hero">
  <h1>Hi, I'm Jess. I design tools to foster learning, community, and experimentation.</h1>
  <p class="lede">Welcome to the garden. Some things here are finished. Others are still growing.</p>
</section>

<section class="filters" aria-label="Filter the garden">
  <div class="frow"><span class="flabel">Stage</span>
    <button class="pill" data-filter="stage" data-value="seedling" aria-pressed="true" data-tip="{{ tips.seedling }}">{{ chipIcon("seedling", 18) }}Seedling</button>
    <button class="pill" data-filter="stage" data-value="budding" aria-pressed="true" data-tip="{{ tips.budding }}">{{ chipIcon("budding", 18) }}Budding</button>
    <button class="pill" data-filter="stage" data-value="evergreen" aria-pressed="true" data-tip="{{ tips.evergreen }}">{{ chipIcon("evergreen", 18) }}Evergreen</button>
  </div>
  <div class="frow"><span class="flabel">Garden</span>
    <button class="pill" data-filter="garden" data-value="community" aria-pressed="true" data-tip="{{ tips.community }}">{{ chipIcon("community", 18) }}Community</button>
    <button class="pill" data-filter="garden" data-value="balcony" aria-pressed="true" data-tip="{{ tips.balcony }}">{{ chipIcon("balcony", 18) }}Balcony</button>
  </div>
</section>

<ul class="rows">
{%- for note in collections.garden %}
  <li class="row" data-stage="{{ note.data.stage }}" data-garden="{{ note.data.garden }}">
    <div class="glyph">{{ stageGlyph(note.data.stage, 28) }}</div>
    <div class="rbody">
      <a class="rtitle" href="{{ note.url }}">{{ note.data.title }}</a>
      {% if note.data.summary %}<p class="rsum">{{ note.data.summary }}</p>{% endif %}
      <div class="rmeta">
        <b tabindex="0" data-tip="{{ tips[note.data.stage] }}">{{ note.data.stage | capitalize }}</b>
        {%- if note | needsTending %}<span class="tend" tabindex="0" data-tip="{{ tips.tending }}">{{ tendGlyph(16) }}Needs watering</span>{% endif %}
        <span class="g" tabindex="0" data-tip="{{ tips[note.data.garden] }}">{{ gardenGlyph(note.data.garden, 16) }}{{ note.data.garden | capitalize }} garden</span>
        {%- for g in writing.groups %}{% if g.slug == note.fileSlug and g.posts.length %}<a href="/writing/#{{ g.slug }}">{{ g.posts.length }} {{ "post" if g.posts.length == 1 else "posts" }} about this</a>{% endif %}{% endfor %}
      </div>
    </div>
  </li>
{%- endfor %}
</ul>
<p class="empty" hidden>Nothing planted here yet.</p>


<script>
(() => {
  // Every chip starts on. A project shows when its stage chip and its garden chip are both on;
  // turn a chip off to hide that kind.
  const state = { stage: new Set(['seedling', 'budding', 'evergreen']), garden: new Set(['community', 'balcony']) };
  const rows = [...document.querySelectorAll('.row')];
  const pills = [...document.querySelectorAll('.pill')];
  const empty = document.querySelector('.empty');
  const apply = () => {
    let shown = 0;
    rows.forEach((r) => {
      const ok = state.stage.has(r.dataset.stage) && state.garden.has(r.dataset.garden);
      r.hidden = !ok;
      if (ok) shown++;
    });
    empty.hidden = shown !== 0;
    pills.forEach((p) => p.setAttribute('aria-pressed', String(state[p.dataset.filter].has(p.dataset.value))));
  };
  pills.forEach((p) => p.addEventListener('click', () => {
    const set = state[p.dataset.filter];
    set.has(p.dataset.value) ? set.delete(p.dataset.value) : set.add(p.dataset.value);
    apply();
  }));
})();
</script>
