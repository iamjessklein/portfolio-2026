---
layout: base.njk
title: Writing
---
{% from "glyphs.njk" import stageGlyph %}
<section class="pagehead">
  <h1>Writing</h1>
  <p class="lede">Most of what I’ve written grew out of something I was making. So it’s sorted by project, not by date. Writing that doesn’t belong to a planted project yet sits in its own patch, waiting to be planted.</p>
</section>

<div class="viewtoggle" role="group" aria-label="Sort writing">
  <button class="pill" data-view="project" aria-pressed="true">By project</button>
  <button class="pill" data-view="year" aria-pressed="false">By year</button>
</div>

<div id="view-project" class="groups">
{%- for g in writing.groups %}
  <section class="group" id="{{ g.slug or (g.name | slugify) }}" aria-label="{{ g.name }}">
    <div class="ghead">
      <div class="glyph">
        {%- if g.slug %}{{ stageGlyph(g.stage, 28) }}{% else %}<svg width="28" height="28" viewBox="0 0 22 22" role="img" aria-label="Not planted yet"><circle cx="11" cy="14" r="5" fill="none" stroke="#5E5546" stroke-width="1.9" stroke-dasharray="2 3"/><path d="M11 9 C11 7 11 6 11 5" stroke="#5E5546" stroke-width="1.2" stroke-linecap="round" stroke-dasharray="1 2.5"/></svg>{% endif -%}
      </div>
      <div class="gtext">
        <div class="gtitle"><h2>{{ g.name }}</h2><span class="gcount">{{ g.countLabel or ((g.posts | length) ~ (" post" if (g.posts | length) == 1 else " posts")) }}</span></div>
        <p class="gblurb">{{ g.blurb }}</p>
        {% if g.slug %}<div class="glink"><a href="/projects/{{ g.slug }}.html">Read about the project →</a></div>{% else %}<div class="gsoft">Not planted yet</div>{% endif %}
      </div>
    </div>
    <div class="gposts">
      {%- for p in g.posts.slice(0, 8) %}
      <div class="post"><span class="pdate">{{ p.date }}</span><span><a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.title }}</a><span class="psrc">{{ p.src }}</span></span></div>
      {%- endfor %}
      {%- if g.posts.length > 8 %}
      <details class="more"><summary>Show the other {{ g.posts.length - 8 }}</summary>
        {%- for p in g.posts.slice(8) %}
        <div class="post"><span class="pdate">{{ p.date }}</span><span><a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.title }}</a><span class="psrc">{{ p.src }}</span></span></div>
        {%- endfor %}
      </details>
      {%- endif %}
      {% if g.note %}<div class="gnote">{{ g.note }} {% if not g.slug and not g.posts.length %}<a href="{{ writing.oldBlog }}" target="_blank" rel="noopener">Visit Blogspot →</a>{% endif %}</div>{% endif %}
    </div>
  </section>
{%- endfor %}
</div>

<div id="view-year" hidden>
  <p class="yearnote">Blogspot only, by year. Medium posts sort by project.</p>
  <ul class="years">
  {%- for y in writing.years %}
    <li><a href="{{ writing.oldBlog }}{{ y.year }}/" target="_blank" rel="noopener"><span class="yr">{{ y.year }}</span><span class="yc">{{ y.count }} posts</span></a></li>
  {%- endfor %}
  </ul>
</div>

<script>
(() => {
  const btns = [...document.querySelectorAll('.viewtoggle .pill')];
  const views = { project: document.getElementById('view-project'), year: document.getElementById('view-year') };
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    Object.entries(views).forEach(([k, el]) => { el.hidden = k !== b.dataset.view; });
  }));
})();
</script>
